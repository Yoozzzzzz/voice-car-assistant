# ==========================================
# Server 端配置模板
# 复制此文件为 .env 并填入真实值，.env 永不入库（.gitignore 已配置）
# ==========================================

# ----- HTTP 服务 -----
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ----- LLM 供应商选择 -----
# zhipu:  智谱 GLM（默认，glm-4.7-flash 永久免费）
# doubao: 火山方舟豆包 Seed（doubao-seed-2-0-mini-260428，按量计费/有免费额度）
# 切换后重启服务生效，可通过 GET /health 的 llm 字段确认
LLM_PROVIDER=zhipu

# ----- 智谱 LLM（OpenAI 兼容接口）-----
# 获取：https://open.bigmodel.cn/ → API Keys
# 模型 glm-4.7-flash 永久免费
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4.7-flash

# ----- 火山方舟豆包 LLM（OpenAI 兼容接口）-----
# 获取：https://console.volcengine.com/ark/region:cn-beijing/apikey → 创建 API Key（ARK_API_KEY）
# 并在方舟控制台"开通管理"开通 Doubao-Seed 模型
# 模型 ID 也可填 Endpoint ID（ep-xxxxxxxx 形式）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-mini-260428

# ----- 讯飞 ASR（语音听写 WebAPI）-----
# 获取：https://www.xfyun.cn/ → 创建应用 → 开通"语音听写"
XUNFEI_APP_ID=
XUNFEI_ASR_API_KEY=
XUNFEI_ASR_API_SECRET=

# ----- 讯飞 TTS（在线语音合成 WebAPI）-----
# 获取：开通"在线语音合成"服务
XUNFEI_TTS_API_KEY=
XUNFEI_TTS_API_SECRET=

# ----- 系统提示词（LLM system 消息，外置 md 便于调优）-----
# 默认 server/prompts/system-prompt.md；填其他路径可覆盖（绝对路径或相对 server 启动目录）
# 修改 md 后重启服务生效；GET /health 的 systemPrompt 字段可确认当前加载来源
SYSTEM_PROMPT_FILE=

# ----- TTS 后端选择 -----
# xunfei: 讯飞 TTS（需 Key）
# edge:   Microsoft Edge TTS 备用（免 Key，中文音色自然度尚可）
TTS_BACKEND=xunfei

# ----- 音频参数（默认值，详见 src/config.ts）-----
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BITS_PER_SAMPLE=16
AUDIO_CHUNK_MS=200

# ----- VAD 参数 -----
# 客户端静音断句（ms），默认 800
VAD_SILENCE_MS=800
# 讯飞服务端 vad_eos 参数（0-10000ms），本项目设 800
VAD_EOS_MS=800