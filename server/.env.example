# ==========================================
# Server 端配置模板
# 复制此文件为 .env 并填入真实值，.env 永不入库（.gitignore 已配置）
# ==========================================

# ----- HTTP 服务 -----
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ----- 智谱 LLM（OpenAI 兼容接口）-----
# 获取：https://open.bigmodel.cn/ → API Keys
# 模型 glm-4.7-flash 永久免费
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
ZHIPU_MODEL=glm-4.7-flash

# ----- 讯飞 ASR（语音听写 WebAPI）-----
# 获取：https://www.xfyun.cn/ → 创建应用 → 开通"语音听写"
XUNFEI_APP_ID=
XUNFEI_ASR_API_KEY=
XUNFEI_ASR_API_SECRET=

# ----- 讯飞 TTS（在线语音合成 WebAPI）-----
# 获取：开通"在线语音合成"服务
XUNFEI_TTS_API_KEY=
XUNFEI_TTS_API_SECRET=

# ----- TTS 后端选择 -----
# xunfei: 讯飞 TTS（需 Key）
# edge:   Microsoft Edge TTS 备用（免 Key，中文音色自然度尚可）
TTS_BACKEND=xunfei

# ----- 音频参数（默认值，详见 src/config.ts）-----
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BITS_PER_SAMPLE=16
AUDIO_CHUNK_MS=200

# ----- VAD 参数 -----
# 客户端静音断句（ms），默认 800
VAD_SILENCE_MS=800
# 讯飞服务端 vad_eos 参数（0-10000ms），本项目设 800
VAD_EOS_MS=800